{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tuning-schema.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "query_parameter", "development_only", "groups"],
  "properties": {
    "version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "query_parameter": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "development_only": { "const": true },
    "groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "controls"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "label"],
      "properties": { "value": { "type": "string" }, "label": { "type": "string", "minLength": 1 } }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "rationale", "default", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["range", "select", "boolean", "text", "text-lines", "image", "section-order", "navigation"] },
        "label": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "default": {},
        "target": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "css_variable": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
            "content_path": { "type": "string", "minLength": 1 },
            "preview_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "class_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "event_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
            "render": { "enum": ["lines", "paragraphs"] },
            "container": { "type": "string", "pattern": "^#[a-z][a-z0-9-]*$" },
            "asset_folder": { "type": "string", "pattern": "^public(?:/[A-Za-z0-9._-]+)+$" },
            "public_base": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$" }
          },
          "minProperties": 1
        },
        "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["", "px", "rem", "em", "vw", "vh", "svh", "dvh", "%", "deg", "ch", "ms", "s"] },
        "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/option" } },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "min_items": { "type": "integer", "minimum": 1, "maximum": 30 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 30 },
        "allowed_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" }
        },
        "allow_hash": { "type": "boolean" },
        "allow_relative": { "type": "boolean" }
      }
    }
  }
}
