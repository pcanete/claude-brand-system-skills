{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-dna-scanner.local/brand-evidence.schema.json",
  "title": "Brand Evidence",
  "type": "object",
  "required": [
    "version",
    "brand",
    "scan",
    "sources",
    "evidence",
    "coverage",
    "limitations"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "scan": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "quick",
            "standard",
            "forensic"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "channel",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "campaign": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "enum": [
            "official-guideline",
            "official-current-owned",
            "official-current-campaign",
            "official-legacy",
            "product",
            "third-party",
            "archive",
            "derived-internal",
            "inferred"
          ],
          "description": "derived-internal: material already distilled from an earlier brand document (a voice guide generated from a dossier, tokens copied out of a manual). It restates the source it came from and is not an observation of the brand."
        },
        "status": {
          "enum": [
            "current",
            "legacy",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "observed": true,
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
