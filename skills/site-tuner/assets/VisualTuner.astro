---
interface Option { value: string; label: string; }
interface Control {
  id: string;
  kind: string;
  label: string;
  default: unknown;
  min?: number;
  max?: number;
  step?: number;
  unit?: string;
  suffix?: string;
  options?: Option[];
}
interface Schema {
  version: string;
  id: string;
  title: string;
  query_parameter?: string;
  groups: Array<{ id: string; label: string; controls: Control[] }>;
}
interface Approved { values?: Record<string, unknown>; }
interface Props {
  schema: Schema;
  approved: Approved;
  saveEndpoint?: string;
}

const { schema, approved, saveEndpoint = '/__visual-tuner/save' } = Astro.props;
const initialValues = Object.fromEntries(
  schema.groups.flatMap((group) => group.controls)
    .map((control) => [control.id, approved.values?.[control.id] ?? control.default]),
);
const safeSchema = JSON.stringify(schema).replace(/</g, '\\u003c');
const safeValues = JSON.stringify(initialValues).replace(/</g, '\\u003c');
---

<aside
  class="visual-tuner"
  data-visual-tuner
  data-save-endpoint={saveEndpoint}
  hidden
  aria-label="Calibrador visual de desarrollo"
>
  <header>
    <div>
      <strong>{schema.title}</strong>
      <small>Exploración local</small>
    </div>
    <button type="button" data-tuner-close aria-label="Cerrar calibrador">×</button>
  </header>

  <div class="visual-tuner__preset">
    <select data-preset-list aria-label="Presets guardados">
      <option value="">Presets locales</option>
    </select>
    <input type="text" data-preset-name maxlength="60" placeholder="Nombre del preset" />
    <button type="button" data-preset-save>Guardar preset</button>
  </div>

  {schema.groups.map((group, groupIndex) => (
    <details class="visual-tuner__group" data-tuner-group={group.id} open={groupIndex === 0}>
      <summary>
        <span>{group.label}</span>
        <span aria-hidden="true">+</span>
      </summary>
      <div class="visual-tuner__group-body">
        {group.controls.map((control) => {
          const value = initialValues[control.id];
          return (
            <label class:list={['visual-tuner__control', `is-${control.kind}`]}>
            <span>
              {control.label}
              {control.kind === 'range' && <output>{String(value)}</output>}
              {control.kind === 'range' && (control.unit || control.suffix) && <small>{control.unit || control.suffix}</small>}
            </span>
            {control.kind === 'range' && (
              <input
                type="range"
                min={control.min}
                max={control.max}
                step={control.step}
                value={String(value)}
                data-control-id={control.id}
                data-control-kind={control.kind}
              />
            )}
            {control.kind === 'select' && (
              <select data-control-id={control.id} data-control-kind={control.kind}>
                {control.options?.map((option) => (
                  <option value={option.value} selected={option.value === value}>{option.label}</option>
                ))}
              </select>
            )}
            {control.kind === 'boolean' && (
              <input
                type="checkbox"
                checked={Boolean(value)}
                data-control-id={control.id}
                data-control-kind={control.kind}
              />
            )}
            {control.kind === 'text-lines' && (
              <textarea
                rows={Math.max(3, Array.isArray(value) ? value.length : 3)}
                spellcheck="false"
                data-control-id={control.id}
                data-control-kind={control.kind}
              >{Array.isArray(value) ? value.join('\n') : String(value ?? '')}</textarea>
            )}
            </label>
          );
        })}
      </div>
    </details>
  ))}

  <footer>
    <button type="button" data-tuner-reset>Descartar pruebas</button>
    <button type="button" data-tuner-export>Copiar JSON</button>
    <button type="button" class="is-primary" data-tuner-apply>Aplicar al proyecto</button>
  </footer>
  <p class="visual-tuner__status" data-tuner-status aria-live="polite"></p>
  <script is:inline type="application/json" data-tuner-schema set:html={safeSchema}></script>
  <script is:inline type="application/json" data-tuner-approved set:html={safeValues}></script>
</aside>

<style>
  .visual-tuner {
    position: fixed;
    z-index: 1000;
    top: 76px;
    right: 14px;
    width: min(360px, calc(100vw - 28px));
    max-height: calc(100svh - 90px);
    overflow: auto;
    border: 1px solid #393939;
    background: rgba(15, 15, 15, 0.97);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.48);
    color: #f2f2f2;
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 11px;
  }
  .visual-tuner[hidden] { display: none; }
  .visual-tuner header,
  .visual-tuner footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 7px;
    padding: 12px;
    border-bottom: 1px solid #393939;
  }
  .visual-tuner footer { flex-wrap: wrap; border-top: 1px solid #393939; border-bottom: 0; }
  .visual-tuner header div { display: grid; gap: 2px; }
  .visual-tuner header small { color: #9a9a9a; text-transform: uppercase; }
  .visual-tuner button,
  .visual-tuner select,
  .visual-tuner input[type="text"],
  .visual-tuner textarea {
    border: 1px solid #4a4a4a;
    background: #111;
    color: inherit;
    font: inherit;
  }
  .visual-tuner button { min-height: 32px; padding: 0 9px; cursor: pointer; }
  .visual-tuner button.is-primary { border-color: var(--signal, #ff350d); background: var(--signal, #ff350d); }
  .visual-tuner header button { width: 32px; padding: 0; font-size: 18px; }
  .visual-tuner__preset {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    padding: 10px 12px;
    border-bottom: 1px solid #393939;
  }
  .visual-tuner__preset button { grid-column: 1 / -1; }
  .visual-tuner__preset select,
  .visual-tuner__preset input { min-width: 0; min-height: 34px; padding: 0 7px; }
  .visual-tuner__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    padding: 9px 12px;
    background: #202020;
    color: #bdbdbd;
    font: inherit;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  .visual-tuner__group summary::-webkit-details-marker { display: none; }
  .visual-tuner__group summary span:last-child { font-size: 17px; line-height: 1; transition: transform 150ms ease; }
  .visual-tuner__group[open] summary span:last-child { transform: rotate(45deg); }
  .visual-tuner__group-body { display: block; }
  .visual-tuner__control {
    display: grid;
    gap: 7px;
    padding: 10px 12px;
    border-bottom: 1px solid #2c2c2c;
  }
  .visual-tuner__control > span { display: flex; align-items: baseline; gap: 4px; }
  .visual-tuner__control output { margin-left: auto; }
  .visual-tuner__control small { color: #999; }
  .visual-tuner__control select,
  .visual-tuner__control textarea { width: 100%; min-height: 34px; }
  .visual-tuner__control textarea { resize: vertical; line-height: 1.4; }
  .visual-tuner__control input[type="range"] { width: 100%; accent-color: var(--signal, #ff350d); }
  .visual-tuner__control.is-boolean { display: flex; flex-direction: row-reverse; justify-content: flex-end; align-items: center; }
  .visual-tuner__status { min-height: 1.2em; margin: 0; padding: 0 12px 12px; color: #9ee7a7; }
  @media (max-width: 600px) {
    .visual-tuner { top: 58px; right: 8px; width: min(330px, calc(100vw - 16px)); max-height: calc(100svh - 66px); }
  }
</style>

<script>
  type Control = {
    id: string;
    kind: 'range' | 'select' | 'boolean' | 'text-lines';
    label: string;
    default: unknown;
    unit?: string;
    css_variable?: string;
    selector?: string;
    item_tag?: string;
    class_name?: string;
    event?: string;
    event_detail?: string;
  };
  type Schema = {
    id: string;
    query_parameter?: string;
    groups: Array<{ controls: Control[] }>;
  };

  const panel = document.querySelector<HTMLElement>('[data-visual-tuner]');
  if (panel) {
    const schema = JSON.parse(panel.querySelector('[data-tuner-schema]')?.textContent || '{}') as Schema;
    const approved = JSON.parse(panel.querySelector('[data-tuner-approved]')?.textContent || '{}') as Record<string, unknown>;
    const params = new URLSearchParams(window.location.search);
    const isActive = params.get(schema.query_parameter || 'tune') === '1';

    if (isActive) {
      panel.hidden = false;
      const controls = schema.groups.flatMap((group) => group.controls);
      const storageKey = `visual-tuner:${schema.id}`;
      const presetKey = `${storageKey}:presets`;
      const status = panel.querySelector<HTMLElement>('[data-tuner-status]');
      const inputFor = (id: string) => panel.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[data-control-id="${id}"]`);
      function parseStored<T>(key: string, fallback: T): T {
        try { return JSON.parse(localStorage.getItem(key) || '') as T; }
        catch { return fallback; }
      }

      const applyControl = (control: Control, value: unknown) => {
        const input = inputFor(control.id);
        if (input instanceof HTMLInputElement && input.type === 'checkbox') input.checked = Boolean(value);
        else if (input) input.value = Array.isArray(value) ? value.join('\n') : String(value ?? '');

        if (control.kind === 'range' && control.css_variable) {
          document.documentElement.style.setProperty(control.css_variable, `${value}${control.unit || ''}`);
          const output = input?.closest('label')?.querySelector('output');
          if (output) output.textContent = String(value);
        }
        if (control.kind === 'boolean' && control.class_name) {
          document.body.classList.toggle(control.class_name, Boolean(value));
        }
        if (control.kind === 'text-lines' && control.selector && Array.isArray(value)) {
          const target = document.querySelector(control.selector);
          const allowedTags = new Set(['span', 'div', 'p', 'li']);
          const tag = allowedTags.has(control.item_tag || '') ? control.item_tag! : 'span';
          target?.replaceChildren(...value.filter(Boolean).map((line) => {
            const item = document.createElement(tag);
            item.textContent = String(line);
            return item;
          }));
        }
        if (control.event) {
          const detailKey = control.event_detail || 'value';
          window.dispatchEvent(new CustomEvent(control.event, { detail: { [detailKey]: value } }));
        }
      };

      const readInput = (control: Control) => {
        const input = inputFor(control.id);
        if (!input) return control.default;
        if (control.kind === 'range') return Number.parseFloat(input.value);
        if (control.kind === 'boolean') return (input as HTMLInputElement).checked;
        if (control.kind === 'text-lines') return input.value.split('\n').map((line) => line.trim()).filter(Boolean);
        return input.value;
      };
      const snapshot = () => Object.fromEntries(controls.map((control) => [control.id, readInput(control)]));
      const persist = () => localStorage.setItem(storageKey, JSON.stringify(snapshot()));
      const applyValues = (values: Record<string, unknown>) => {
        controls.forEach((control) => applyControl(control, values[control.id] ?? approved[control.id] ?? control.default));
      };

      const experiments = parseStored<Record<string, unknown>>(storageKey, {});
      applyValues({ ...approved, ...experiments });

      controls.forEach((control) => {
        const input = inputFor(control.id);
        const eventName = control.kind === 'select' || control.kind === 'boolean' ? 'change' : 'input';
        input?.addEventListener(eventName, () => {
          applyControl(control, readInput(control));
          persist();
        });
      });

      const presetList = panel.querySelector<HTMLSelectElement>('[data-preset-list]');
      const presetName = panel.querySelector<HTMLInputElement>('[data-preset-name]');
      const readPresets = () => parseStored<Record<string, Record<string, unknown>>>(presetKey, {});
      const refreshPresets = () => {
        if (!presetList) return;
        const current = presetList.value;
        presetList.replaceChildren(new Option('Presets locales', ''));
        Object.keys(readPresets()).sort().forEach((name) => presetList.add(new Option(name, name)));
        presetList.value = current;
      };
      refreshPresets();
      presetList?.addEventListener('change', () => {
        const preset = readPresets()[presetList.value];
        if (preset) {
          applyValues(preset);
          persist();
          if (status) status.textContent = `Preset cargado: ${presetList.value}`;
        }
      });
      panel.querySelector('[data-preset-save]')?.addEventListener('click', () => {
        const name = presetName?.value.trim();
        if (!name) {
          if (status) status.textContent = 'Escriba un nombre para el preset.';
          return;
        }
        const presets = readPresets();
        presets[name] = snapshot();
        localStorage.setItem(presetKey, JSON.stringify(presets));
        refreshPresets();
        if (presetList) presetList.value = name;
        if (status) status.textContent = `Preset guardado: ${name}`;
      });

      panel.querySelector('[data-tuner-close]')?.addEventListener('click', () => { panel.hidden = true; });
      panel.querySelector('[data-tuner-reset]')?.addEventListener('click', () => {
        localStorage.removeItem(storageKey);
        applyValues(approved);
        if (status) status.textContent = 'Pruebas locales descartadas.';
      });
      panel.querySelector('[data-tuner-export]')?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(JSON.stringify({ schema: schema.id, values: snapshot() }, null, 2));
          if (status) status.textContent = 'Configuración copiada.';
        } catch {
          if (status) status.textContent = 'No se pudo copiar.';
        }
      });
      panel.querySelector('[data-tuner-apply]')?.addEventListener('click', async () => {
        if (status) status.textContent = 'Aplicando al proyecto…';
        try {
          const response = await fetch(panel.dataset.saveEndpoint || '/__visual-tuner/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ schema: schema.id, values: snapshot() }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'No se pudo guardar.');
          localStorage.removeItem(storageKey);
          if (status) status.textContent = 'Configuración aplicada al proyecto.';
        } catch (error) {
          if (status) status.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        }
      });
    }
  }
</script>
