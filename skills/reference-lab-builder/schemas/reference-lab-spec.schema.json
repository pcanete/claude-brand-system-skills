{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-lab-spec.schema.json",
  "title": "Reference Lab Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "theme", "demos", "responsive_cases", "review"],
  "properties": {
    "version": { "const": "0.1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_label", "objective", "generated_from"],
      "properties": {
        "reference_label": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "generated_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style_dna", "reference_evidence"],
          "properties": {
            "style_dna": { "type": "string", "minLength": 1 },
            "reference_evidence": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "ink", "muted", "accent", "border", "display_family", "body_family", "mono_family"],
      "properties": {
        "canvas": { "$ref": "#/$defs/color" },
        "ink": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "display_family": { "type": "string", "minLength": 1 },
        "body_family": { "type": "string", "minLength": 1 },
        "mono_family": { "type": "string", "minLength": 1 }
      }
    },
    "demos": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "source_paths", "evidence_refs", "config", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["typography", "hover-label", "navigation", "marquee", "scroll-reveal", "sticky-stack", "parallax", "loader", "filter", "media-sequence", "drag-surface", "fullscreen", "page-transition", "webgl-scene"] },
          "source_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "config": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": ["string", "number", "boolean", "null"] },
                { "type": "array", "items": { "type": ["string", "number", "boolean"] } }
              ]
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "responsive_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "width", "height", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 280 },
          "height": { "type": "integer", "minimum": 480 },
          "notes": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checklist", "approved_by", "approved_at"],
      "properties": {
        "status": { "enum": ["draft", "changes-requested", "approved"] },
        "checklist": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "status", "notes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pending", "accepted", "changes-requested"] },
              "notes": { "type": "string" }
            }
          }
        },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
}
